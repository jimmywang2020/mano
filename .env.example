# Copy to `.env` and fill in. Never commit the real `.env`.

# Provider API key for the GUI VLM (DashScope / 阿里百炼 gui-plus by default).
# Falls back to DASHSCOPE_API_KEY if MANO_API_KEY is unset.
MANO_API_KEY=

# Android device/emulator serial (adb -s <serial>).
# MuMu's adb port drifts per launch — prefer auto-detect over hardcoding:
#   eval "$(bash scripts/mumu-adb.sh)"
# Only set this for a fixed serial; a stale value here overrides that export.
# MANO_DEVICE_SERIAL=127.0.0.1:16384

# Optional overrides
# MANO_MODEL=gui-plus-2026-02-26
# MANO_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# MANO_ADB_PATH=/absolute/path/to/adb

# Optional cost accounting: your provider's price per 1K tokens (input/output).
# Leave unset to report token counts with est_cost=0. Fill from the current price list.
# MANO_PRICE_IN_PER_1K=0
# MANO_PRICE_OUT_PER_1K=0
