# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/

# Dependency lock: mano is a library (zero runtime deps); consumers resolve their
# own. The uv.lock only pins the dev/test extra and is not a shipped artifact.
uv.lock

# Secrets / machine-specific env
.env
.env.*
!.env.example

# Run evidence: screenshots + UI XML can contain personal account data.
# Never publish. Keep local unless a reviewed, redacted package is prepared.
packs/*/runs/
runs/

# OS / editor
.DS_Store
.idea/
.vscode/
HANDOFF_NEXT_SESSION.md
